# Valores exclusivamente locais/de demonstração. Não use estas credenciais em produção.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://portal:portal@127.0.0.1:5432/portal?sslmode=disable
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_PORT=5432
# Compose publica somente o frontend por padrão; PostgreSQL fica ligado ao loopback.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
# A URL interna usa o nome do serviço Docker, não localhost. Ao trocar as
# credenciais do PostgreSQL acima, mantenha esta URL coerente e use URL-encoding.
COMPOSE_DATABASE_URL=postgres://portal:portal@postgres:5432/portal?sslmode=disable
COMPOSE_TRUSTED_ORIGINS=http://127.0.0.1:8080
BACKEND_IMAGE=portal-solicitacoes-backend:local
FRONTEND_IMAGE=portal-solicitacoes-frontend:local
DATABASE_CONNECT_TIMEOUT=3s
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
MIGRATIONS_DIR=db/migrations
TRUSTED_ORIGINS=http://127.0.0.1:5173
SESSION_DURATION=8h
SESSION_TOKEN_BYTES=32
# false somente no HTTP local; produção exige true/HTTPS.
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=15m
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000

# Banco descartável exclusivo para testes de integração. A suíte também exige
# nome terminado em _test e confirmação explícita antes de executar TRUNCATE.
TEST_DATABASE_URL=postgres://portal_test:portal_test@127.0.0.1:55435/portal_test?sslmode=disable
TEST_DATABASE_ALLOW_RESET=no
TEST_POSTGRES_PORT=55435

# Seed opcional. Credenciais PÚBLICAS, exclusivamente para ambiente local/de teste.
DEMO_SEED_ENABLED=false
DEMO_USER1_USERNAME=colaborador1
DEMO_USER1_DISPLAY_NAME="Colaborador 1"
DEMO_USER1_PASSWORD=DemoLocal-Colaborador1
DEMO_USER2_USERNAME=colaborador2
DEMO_USER2_DISPLAY_NAME="Colaborador 2"
DEMO_USER2_PASSWORD=DemoLocal-Colaborador2
